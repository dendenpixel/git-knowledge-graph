#Find all users who have made concurrent contributions to three or more repositories;
PREFIX git: <http://www.semanticweb.org/user/ontologies/2025/9/gitOntology_Project#>

SELECT ?user ?day (COUNT(DISTINCT ?repo) AS ?repoCounter)
WHERE {
  ?commit a git:Commit; git:madeBy ?user ; git:commitDate ?dateTime; git:belongsTo ?branch.
  ?branch git:derivedFrom ?repo.
  BIND(SUBSTR(STR(?dateTime), 1, 10) AS ?day)   # yyyy-mm-dd, 11 would still work but day result ends with T, any more than 12 breaks results.
}
GROUP BY ?user ?day
HAVING (COUNT(DISTINCT ?repo) >= 2) # The question asks for 3, but nobody in my data touched 3 repos in one day (2, yes), so this is curbed to 2 to show results. Change it back to 3 for the strict version.
ORDER BY DESC(?repoCounter) ?user ?day
LIMIT 20
